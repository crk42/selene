<div id="categoryTransactionModal" class="modal">
  <div class="modal-content large-modal">
    <div class="modal-header">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <h2 id="categoryModalTitle" style="margin: 0;">Category Details</h2>
        <select id="categoryModalSelect" onchange="openCategoryModal(this.value)" style="width: auto; padding: 0.25rem 0.5rem; font-size: 1rem; border-radius: 0.5rem;">
          <% if @categories %>
            <% @categories.each do |type, categories| %>
              <optgroup label="<%= type.capitalize %>">
                <% categories.each do |cat| %>
                  <option value="<%= cat.name %>"><%= cat.name %></option>
                <% end %>
              </optgroup>
            <% end %>
          <% end %>
        </select>
      </div>
      <span class="close" onclick="closeCategoryModal()">&times;</span>
    </div>
    
    <div class="modal-body">
      <div id="categoryTransactionsList" class="transactions-list">
        <!-- Transactions will be loaded here -->
        <div class="loading-spinner">Loading...</div>
      </div>
      
      <div id="categoryPagination" class="pagination-controls">
        <button id="prevPageBtn" onclick="changeCategoryPage(-1)" disabled>&laquo; Previous</button>
        <span id="pageInfo">Page 1 of 1</span>
        <button id="nextPageBtn" onclick="changeCategoryPage(1)" disabled>Next &raquo;</button>
      </div>
    </div>
  </div>
</div>
