<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Monthly trend chart
  const chartElement = document.getElementById('monthlyChart');
  if (chartElement) {
    const ctx = chartElement.getContext('2d');
    const monthlyData = <%= (@monthly_data || []).to_json %>;
    
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: monthlyData.map(d => d.month),
        datasets: [
          {
            label: 'Income',
            data: monthlyData.map(d => d.income),
            borderColor: 'rgb(34, 197, 94)',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            tension: 0.4,
            fill: true
          },
          {
            label: 'Expenses',
            data: monthlyData.map(d => d.expenses),
            borderColor: 'rgb(239, 68, 68)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            tension: 0.4,
            fill: true
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: true,
            position: 'top',
            labels: {
              color: '#e5e7eb',
              font: {
                family: 'Inter',
                size: 12
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            },
            ticks: {
              color: '#9ca3af',
              callback: function(value) {
                return '$' + value.toLocaleString();
              }
            }
          },
          x: {
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            },
            ticks: {
              color: '#9ca3af'
            }
          }
        }
      }
    });
  }

  // Category breakdown pie chart
  const breakdownElement = document.getElementById('typeBreakdownChart');
  if (breakdownElement) {
    const ctx = breakdownElement.getContext('2d');
    const categoryData = <%= (@category_data || {}).to_json %>;
    const labels = Object.keys(categoryData);
    const values = Object.values(categoryData);
    
    const colors = [
      '#6366f1', '#8b5cf6', '#ec4899', '#ef4444', 
      '#f59e0b', '#10b981', '#06b6d4', '#3b82f6',
      '#a855f7', '#f43f5e', '#fb923c', '#2dd4bf'
    ];
    
    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: colors.slice(0, labels.length),
          borderWidth: 0,
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '70%',
        onClick: (e, activeElements) => {
          if (activeElements.length > 0) {
            const index = activeElements[0].index;
            const label = labels[index];
            openCategoryModal(label);
          }
        },
        onHover: (event, chartElement) => {
          event.native.target.style.cursor = chartElement[0] ? 'pointer' : 'default';
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              color: '#e5e7eb',
              padding: 20,
              usePointStyle: true,
              font: {
                family: 'Inter',
                size: 11,
                weight: '500'
              }
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                return `${label}: $${value.toLocaleString()} (${percentage}%)`;
              }
            }
          }
        }
      }

    });
  }

  // 6-Month Category breakdown pie chart
  const sixMonthBreakdownElement = document.getElementById('sixMonthBreakdownChart');
  if (sixMonthBreakdownElement) {
    const ctx = sixMonthBreakdownElement.getContext('2d');
    const categoryData = <%= (@category_data_six_months || {}).to_json %>;
    const labels = Object.keys(categoryData);
    const values = Object.values(categoryData);
    
    const colors = [
      '#6366f1', '#8b5cf6', '#ec4899', '#ef4444', 
      '#f59e0b', '#10b981', '#06b6d4', '#3b82f6',
      '#a855f7', '#f43f5e', '#fb923c', '#2dd4bf',
      '#14b8a6', '#84cc16', '#eab308', '#f97316'
    ];
    
    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: colors.slice(0, labels.length),
          borderWidth: 0,
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '70%',
        onClick: (e, activeElements) => {
          if (activeElements.length > 0) {
            const index = activeElements[0].index;
            const label = labels[index];
            openCategoryModal(label);
          }
        },
        onHover: (event, chartElement) => {
          event.native.target.style.cursor = chartElement[0] ? 'pointer' : 'default';
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              color: '#e5e7eb',
              padding: 20,
              usePointStyle: true,
              font: {
                family: 'Inter',
                size: 11,
                weight: '500'
              }
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                return `${label}: $${value.toLocaleString()} (${percentage}%)`;
              }
            }
          }
        }
      }

    });
  }

  // Modal functionality
  const modal = document.getElementById("transactionModal");
  const modalTitle = document.getElementById("modalTitle");
  const transactionForm = document.getElementById("transactionForm");
  
  function openAddModal() {
    modal.style.display = "block";
    modalTitle.textContent = "Add Transaction";
    transactionForm.action = "/transactions";
    transactionForm.reset();
    
    // Set default date to today
    const dateInput = document.getElementById('transaction_date');
    if (dateInput) {
      dateInput.valueAsDate = new Date();
    }
    
    // Reset category view
    const categorySelect = document.getElementById('category');
    if (categorySelect) categorySelect.value = "";
  }
  
  function editTransaction(button) {
    const transaction = JSON.parse(button.dataset.transaction);
    
    modal.style.display = "block";
    modalTitle.textContent = "Edit Transaction";
    transactionForm.action = `/transactions/${transaction.id}`;
    
    document.getElementById('description').value = transaction.description;
    document.getElementById('amount').value = transaction.amount;
    document.getElementById('transaction_date').value = transaction.transaction_date;
    
    const typeSelect = document.getElementById('transaction_type');
    typeSelect.value = transaction.transaction_type;
    
    // Trigger change event to filter categories
    typeSelect.dispatchEvent(new Event('change'));
    
    const categorySelect = document.getElementById('category');
    categorySelect.value = transaction.category;
  }
  
  function closeModal() {
    modal.style.display = "none";
  }
  
  // Close modal when clicking outside
  window.onclick = function(event) {
    if (event.target == modal) {
      modal.style.display = "none";
    }
  }

  // Bulk Selection Logic
  const selectAll = document.getElementById('selectAll');
  const transactionCheckboxes = document.querySelectorAll('.transaction-checkbox');
  const bulkActionBar = document.getElementById('bulkActionBar');
  const selectedCount = document.getElementById('selectedCount');

  if (selectAll) {
    selectAll.addEventListener('change', function() {
      transactionCheckboxes.forEach(checkbox => {
        checkbox.checked = selectAll.checked;
      });
      updateBulkActionBar();
    });

    transactionCheckboxes.forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        updateBulkActionBar();
        
        // Update Select All state
        const allChecked = Array.from(transactionCheckboxes).every(cb => cb.checked);
        const noneChecked = Array.from(transactionCheckboxes).every(cb => !cb.checked);
        selectAll.checked = allChecked;
        selectAll.indeterminate = !allChecked && !noneChecked;
      });
    });
  }

  function updateBulkActionBar() {
    const checkedCount = Array.from(transactionCheckboxes).filter(cb => cb.checked).length;
    
    if (checkedCount > 0) {
      bulkActionBar.classList.remove('hidden');
      selectedCount.textContent = `${checkedCount} item${checkedCount > 1 ? 's' : ''} selected`;
    } else {
      bulkActionBar.classList.add('hidden');
    }
  }

  function toggleNewCategoryInput() {
    const newCategoryInput = document.getElementById('newCategoryInput');
    const categorySelect = document.getElementById('category');
    
    if (newCategoryInput.style.display === 'none' || newCategoryInput.classList.contains('hidden')) {
      newCategoryInput.style.display = 'flex';
      newCategoryInput.classList.remove('hidden');
      categorySelect.value = 'new_category_option';
      newCategoryInput.querySelector('input').focus();
    } else {
      newCategoryInput.style.display = 'none';
      newCategoryInput.classList.add('hidden');
      if (categorySelect.value === 'new_category_option') {
        categorySelect.value = "";
      }
    }
  }

  function checkNewCategory(select) {
    const newCategoryInput = document.getElementById('newCategoryInput');
    if (select.value === 'new_category_option') {
      newCategoryInput.style.display = 'flex';
      newCategoryInput.querySelector('input').focus();
    } else {
      newCategoryInput.style.display = 'none';
    }
  }

  function saveNewCategory() {
    const nameInput = document.getElementById('newCategoryName');
    const name = nameInput.value.trim();
    const typeSelect = document.getElementById('transaction_type');
    const type = typeSelect.value;
    const categorySelect = document.getElementById('category');

    if (!name) return;

    fetch('/categories', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: `name=${encodeURIComponent(name)}&type=${encodeURIComponent(type)}`
    })
    .then(response => response.json())
    .then(data => {
      if (data.error) {
        alert(data.error);
      } else {
        // Create new option
        const option = document.createElement('option');
        option.value = data.name;
        option.text = data.name;
        option.selected = true;
        option.dataset.type = data.category_type;

        // Find or create optgroup
        let optgroup = Array.from(categorySelect.getElementsByTagName('optgroup'))
          .find(g => g.label.toLowerCase() === data.category_type);
        
        if (!optgroup) {
          optgroup = document.createElement('optgroup');
          optgroup.label = data.category_type.charAt(0).toUpperCase() + data.category_type.slice(1);
          // Insert before "Create New" option
          categorySelect.insertBefore(optgroup, categorySelect.options[categorySelect.options.length - 1]);
        }
        
        optgroup.appendChild(option);
        
        // Reset input
        document.getElementById('newCategoryInput').style.display = 'none';
        nameInput.value = '';
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Failed to create category');
    });
  }

  // Filter categories based on transaction type
  const typeSelect = document.getElementById('transaction_type');
  const categorySelect = document.getElementById('category');
  
  if (typeSelect && categorySelect) {
    typeSelect.addEventListener('change', function() {
      const selectedType = this.value;
      const options = categorySelect.querySelectorAll('option');
      const optgroups = categorySelect.querySelectorAll('optgroup');
      
      optgroups.forEach(group => {
        if (group.label.toLowerCase() === selectedType) {
          group.style.display = '';
        } else {
          group.style.display = 'none';
        }
      });

      // Reset selection if hidden
      if (categorySelect.selectedOptions[0] && 
          categorySelect.selectedOptions[0].dataset.type && 
          categorySelect.selectedOptions[0].dataset.type !== selectedType) {
        categorySelect.value = "";
      }
    });
    
    // Trigger initially
    typeSelect.dispatchEvent(new Event('change'));
  }
</script>

<script>
  // Category Modal Logic
  let currentCategory = null;
  let currentPage = 1;
  const categoryModal = document.getElementById("categoryTransactionModal");
  const categoryList = document.getElementById("categoryTransactionsList");
  const prevBtn = document.getElementById("prevPageBtn");
  const nextBtn = document.getElementById("nextPageBtn");
  const pageInfo = document.getElementById("pageInfo");

  function openCategoryModal(category) {
    currentCategory = category;
    currentPage = 1;
    document.getElementById("categoryModalTitle").textContent = `${category} Transactions`;
    categoryModal.style.display = "block";
    fetchCategoryTransactions(category, currentPage);
  }

  function closeCategoryModal() {
    categoryModal.style.display = "none";
  }

  function changeCategoryPage(direction) {
    currentPage += direction;
    fetchCategoryTransactions(currentCategory, currentPage);
  }

  function fetchCategoryTransactions(category, page) {
    categoryList.innerHTML = '<div class="loading-spinner">Loading...</div>';
    
    fetch(`/categories/${encodeURIComponent(category)}/transactions?page=${page}`)
      .then(response => response.json())
      .then(data => {
        renderCategoryTransactions(data.transactions);
        updatePagination(data.page, data.total_pages);
      })
      .catch(error => {
        console.error('Error fetching transactions:', error);
        categoryList.innerHTML = '<div class="error-message">Failed to load transactions.</div>';
      });
  }

  function renderCategoryTransactions(transactions) {
    if (transactions.length === 0) {
      categoryList.innerHTML = '<div class="empty-state"><p>No transactions found.</p></div>';
      return;
    }

    const html = transactions.map(t => {
      // Handle date parsing (assuming format YYYY-MM-DD from backend JSON)
      const dateStr = t.transaction_date;
      const date = new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      
      const amountClass = t.transaction_type === 'income' ? 'income' : 'expense';
      const sign = t.transaction_type === 'income' ? '+' : '-';
      
      return `
        <div class="transaction-item ${t.transaction_type}">
          <div class="transaction-left">
            <div class="transaction-icon">
              ${t.transaction_type === 'income' ? '💵' : '💳'}
            </div>
            <div class="transaction-details">
              <div class="transaction-description">${t.description}</div>
              <div class="transaction-meta">
                ${date}
              </div>
            </div>
          </div>
          <div class="transaction-right">
            <div class="transaction-amount ${amountClass}">
              ${sign}$${parseFloat(t.amount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}
            </div>
          </div>
        </div>
      `;
    }).join('');

    categoryList.innerHTML = html;
  }

  function updatePagination(current, total) {
    pageInfo.textContent = `Page ${current} of ${total}`;
    prevBtn.disabled = current <= 1;
    nextBtn.disabled = current >= total;
  }

  // Close modal when clicking outside
  window.addEventListener('click', function(event) {
    if (event.target == categoryModal) {
      closeCategoryModal();
    }
  });
</script>
