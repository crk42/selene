<div id="transactionModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle">Add Transaction</h2>
      <span class="close" onclick="closeModal()">&times;</span>
    </div>
    <form action="/transactions" method="POST" id="transactionForm">
      <div class="form-group">
        <label for="description">Description</label>
        <input type="text" id="description" name="description" placeholder="e.g. Salary, Groceries" required>
      </div>
      
      <div class="form-group">
        <label for="amount">Amount ($)</label>
        <input type="number" id="amount" name="amount" step="0.01" min="0.01" placeholder="0.00" required>
      </div>

      <div class="form-group">
        <label for="transaction_type">Type</label>
        <select id="transaction_type" name="transaction_type" required>
          <option value="expense">Expense</option>
          <option value="income">Income</option>
        </select>
      </div>
      
      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <label for="category" style="margin-bottom: 0;">Category</label>
          <button type="button" class="btn-icon-action" onclick="toggleNewCategoryInput()">
            <span>+</span> New
          </button>
        </div>
        <div class="category-wrapper">
          <select id="category" name="category" required onchange="checkNewCategory(this)">
            <option value="" disabled selected>Select a category</option>
            <% if @categories %>
              <% @categories.each do |type, categories| %>
                <optgroup label="<%= type.capitalize %>">
                  <% categories.each do |cat| %>
                    <option value="<%= cat.name %>" data-type="<%= cat.category_type %>"><%= cat.name %></option>
                  <% end %>
                </optgroup>
              <% end %>
            <% end %>
            <option value="new_category_option">+ Create New Category</option>
          </select>
          <div id="newCategoryInput" class="hidden input-with-action" style="display: none;">
            <input type="text" id="newCategoryName" placeholder="Enter new category name">
            <button type="button" class="btn-action" onclick="saveNewCategory()">+ Add</button>
          </div>
        </div>
      </div>

      
      <div class="form-group">
        <label for="transaction_date">Date</label>
        <input type="date" id="transaction_date" name="transaction_date" value="<%= Date.today %>" required>
      </div>
      
      <button type="submit" class="btn-submit">Save Transaction</button>
    </form>
  </div>
</div>
