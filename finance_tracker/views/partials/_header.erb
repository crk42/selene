<header class="dashboard-header">
  <div class="header-content">
    <h1 class="app-title">
      <span class="icon">💰</span>
       <a href="/">Finance Tracker</a>
    </h1>
    <div class="header-date"><%= Date.today.strftime('%B %d, %Y') %></div>
    <div class="header-actions">
      <form action="/import" method="POST" enctype="multipart/form-data" style="display: inline-block; margin-right: 10px;">
        <label for="file-upload" class="btn-secondary" style="cursor: pointer;">
          Import CSV
        </label>
        <input id="file-upload" name="file" type="file" accept=".csv" style="display: none;" onchange="this.form.submit()">
      </form>
      <button class="btn-primary" onclick="openAddModal()">+ Add Transaction</button>
    </div>
  </div>
</header>
