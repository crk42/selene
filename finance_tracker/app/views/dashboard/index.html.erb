<div class="dashboard-container">
  <!-- Header -->
  <header class="dashboard-header">
    <div class="header-content">
      <h1 class="app-title">
        <span class="icon">💰</span>
        Finance Tracker
      </h1>
      <div class="header-date"><%= Date.today.strftime('%B %d, %Y') %></div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="dashboard-main">
    <!-- Summary Cards -->
    <div class="summary-cards">
      <div class="card card-income">
        <div class="card-icon">📈</div>
        <div class="card-content">
          <div class="card-label">Total Income</div>
          <div class="card-value">$<%= number_with_precision(@total_income, precision: 2, delimiter: ',') %></div>
          <div class="card-sublabel">This month: $<%= number_with_precision(@month_income, precision: 2, delimiter: ',') %></div>
        </div>
      </div>

      <div class="card card-expense">
        <div class="card-icon">📉</div>
        <div class="card-content">
          <div class="card-label">Total Expenses</div>
          <div class="card-value">$<%= number_with_precision(@total_expenses, precision: 2, delimiter: ',') %></div>
          <div class="card-sublabel">This month: $<%= number_with_precision(@month_expenses, precision: 2, delimiter: ',') %></div>
        </div>
      </div>

      <div class="card card-balance">
        <div class="card-icon">💎</div>
        <div class="card-content">
          <div class="card-label">Current Balance</div>
          <div class="card-value <%= @current_balance >= 0 ? 'positive' : 'negative' %>">
            $<%= number_with_precision(@current_balance.abs, precision: 2, delimiter: ',') %>
          </div>
          <div class="card-sublabel"><%= @current_balance >= 0 ? 'Surplus' : 'Deficit' %></div>
        </div>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-section">
      <div class="chart-container">
        <h2 class="section-title">6-Month Trend</h2>
        <div class="chart-wrapper">
          <canvas id="monthlyChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Recent Transactions -->
    <div class="transactions-section">
      <h2 class="section-title">Recent Transactions</h2>
      <div class="transactions-list">
        <% if @recent_transactions.any? %>
          <% @recent_transactions.each do |transaction| %>
            <div class="transaction-item <%= transaction.transaction_type %>">
              <div class="transaction-left">
                <div class="transaction-icon">
                  <%= transaction.transaction_type == 'income' ? '💵' : '💳' %>
                </div>
                <div class="transaction-details">
                  <div class="transaction-description"><%= transaction.description %></div>
                  <div class="transaction-meta">
                    <%= transaction.transaction_date.strftime('%b %d, %Y') %>
                    <% if transaction.category.present? %>
                      <span class="category-badge"><%= transaction.category %></span>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="transaction-amount <%= transaction.transaction_type %>">
                <%= transaction.transaction_type == 'income' ? '+' : '-' %>$<%= number_with_precision(transaction.amount, precision: 2, delimiter: ',') %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="empty-state">
            <div class="empty-icon">📊</div>
            <p>No transactions yet. Start tracking your finances!</p>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Monthly trend chart
  const ctx = document.getElementById('monthlyChart').getContext('2d');
  const monthlyData = <%= raw @monthly_data.to_json %>;
  
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: monthlyData.map(d => d.month),
      datasets: [
        {
          label: 'Income',
          data: monthlyData.map(d => parseFloat(d.income)),
          borderColor: 'rgb(34, 197, 94)',
          backgroundColor: 'rgba(34, 197, 94, 0.1)',
          tension: 0.4,
          fill: true
        },
        {
          label: 'Expenses',
          data: monthlyData.map(d => parseFloat(d.expenses)),
          borderColor: 'rgb(239, 68, 68)',
          backgroundColor: 'rgba(239, 68, 68, 0.1)',
          tension: 0.4,
          fill: true
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: true,
          position: 'top',
          labels: {
            color: '#e5e7eb',
            font: {
              family: 'Inter',
              size: 12
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          grid: {
            color: 'rgba(255, 255, 255, 0.1)'
          },
          ticks: {
            color: '#9ca3af',
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        },
        x: {
          grid: {
            color: 'rgba(255, 255, 255, 0.1)'
          },
          ticks: {
            color: '#9ca3af'
          }
        }
      }
    }
  });
</script>
